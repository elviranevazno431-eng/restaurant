{
  "router_config": {
    "base_path": "/src/Routes/web.php",
    "middleware": ["auth_required"],
    "cache_ttl": 3600,
    "error_handling": {
      "404": "/assets/views/404.php",
      "500": "/assets/views/500.php"
    }
  },
  "order_statuses": [
    {"code": "new", "name": "Новый", "color": "blue"},
    {"code": "confirmed", "name": "Подтверждён", "color": "purple"},
    {"code": "cooking", "name": "Готовится", "color": "orange"},
    {"code": "ready", "name": "Готов", "color": "yellow"},
    {"code": "delivered", "name": "Доставлен", "color": "green"},
    {"code": "cancelled", "name": "Отменён", "color": "red"}
  ],
  "validation_rules": {
    "min_items": 1,
    "max_total": 50000,
    "required_fields": ["user_id", "items", "total_amount"],
    "delivery_fee": 250,
    "free_delivery_from": 3000
  },
  "email_settings": {
    "from": "noreply@gourmet-restaurant.local",
    "token_lifetime_hours": 24,
    "templates": {
      "registration": "templates/email/register.html",
      "order_confirm": "templates/email/order.html"
    }
  }
}